{
  "content_hash": "sha256:4432c1b602c7f5948696e39b3782ea8b16b5f96d4d429a78a038f8f8ed784284",
  "created": "2026-06-24",
  "description": "End-to-end procedure for fitting cover boards to a sewn book: cutting the boards square, lining them, marking and punching for the cords, lacing them in and hammering flat, then cleaning off the back and pressing the volume to set its shape.",
  "emitter": "opg://commons-seed",
  "id": "cutting-and-attaching-boards-seed",
  "kind": "workflow",
  "lineage": {
    "outcome": "unknown",
    "provenance_state": "unasserted"
  },
  "modified": "2026-06-24",
  "name": "cutting and attaching boards",
  "opgl_version": "0.6",
  "persistent": false,
  "properties": {
    "difficulty": "advanced",
    "license": "CC-BY-4.0",
    "names": {
      "en": [
        "cutting and attaching boards"
      ]
    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Select board of a thickness suited to the size and weight of the volume; for vellum books use clasped wooden boards.",
        "position": 1
      },
      {
        "description": "Rough-cut the boards to size with the shears in the press, or with a board machine for bulk work.",
        "position": 2
      },
      {
        "description": "True one edge of each board in the plough, then rub down the burr with a folder.",
        "position": 3
      },
      {
        "description": "Line the boards with paper, doubling the outer face to bias the warp, and nip in the press; stand to dry.",
        "position": 4
      },
      {
        "description": "Pair the dried boards, mark them square with a try square and compasses, and cut the remaining edges in the plough.",
        "position": 5
      },
      {
        "description": "Mark the slip positions, punch two series of holes with a bodkin over a lead plate, and cut V-grooves to recess the slips.",
        "position": 6
      },
      {
        "description": "Scrape and reduce the frayed slips, paste them, point the ends, and thread them through the holes.",
        "position": 7
      },
      {
        "description": "Tension the laced slips, cut the ends flush, and hammer them flat on the knocking-down iron from both sides.",
        "position": 8
      },
      {
        "description": "Paste the back, let it soak, and scrape off the softened surplus glue to clean off the spine.",
        "position": 9
      },
      {
        "description": "Build the books into the standing press with tins in the joints and leave under even pressure overnight to set the form.",
        "position": 10
      }
    ],
    "taxonomy": "forwarding-technique"
  },
