{
  "content_hash": "sha256:ecea7b1a8b8c41ac7acb09809840814aba9a387fbf22634050e915dcdf35462d",
  "created": "2026-06-24",
  "description": "The full sequence for tooling a leather cover in gold, from preparing the surface through laying the gold, striking the pattern, cleaning off, and varnishing the finished binding.",
  "emitter": "opg://commons-seed",
  "id": "gold-finishing-seed",
  "kind": "workflow",
  "lineage": {
    "outcome": "unknown",
    "provenance_state": "unasserted"
  },
  "modified": "2026-06-24",
  "name": "gold finishing",
  "opgl_version": "0.6",
  "persistent": false,
  "properties": {
    "difficulty": "advanced",
    "license": "CC-BY-4.0",
    "names": {
      "en": [
        "gold finishing"
      ]
    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Polish the back warm and crush the grain of the leather if much finishing is planned.",
        "position": 1
      },
      {
        "description": "Decide the lettering and decoration and prepare paper patterns for an elaborate design.",
        "position": 2
      },
      {
        "description": "Hold the book in the finishing press, fix the paper pattern across the back or on the sides, and blind in the design with cooled tools.",
        "position": 3
      },
      {
        "description": "Wash the cover clean, then wash porous leather with paste-water and size.",
        "position": 4
      },
      {
        "description": "Paint the tool impressions with glaire, giving heavy or porous work a second coat.",
        "position": 5
      },
      {
        "description": "Grease the cover lightly, pick up cut gold leaf on a cotton-wool pad, and lay it over the prepared impressions.",
        "position": 6
      },
      {
        "description": "Work the pattern through the gold with hot tools, judging the heat by trial for the leather in hand.",
        "position": 7
      },
      {
        "description": "Rub off loose gold, inspect for imperfect impressions, and reglaire and retool any that failed.",
        "position": 8
      },
      {
        "description": "Wash the cover with benzine, polish and varnish the margins and sides, and press the boards to finish.",
        "position": 9
      }
    ],
    "taxonomy": "decoration-technique"
  },
