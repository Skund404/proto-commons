  },
  "modified": "2026-06-24",
  "name": "preparing sheets for binding",
  "opgl_version": "0.6",
  "persistent": false,
  "properties": {
    "difficulty": "intermediate",
    "license": "CC-BY-4.0",
    "names": {
      "en": [
        "preparing sheets for binding"
      ]
    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (1901), Chapter II, p.33. Internet Archive.",
        "url": "https://archive.org/details/bookbindingcareo00cockrich/page/33"
      },
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Gather one sheet from each pile of signatures to assemble a complete copy.",
        "position": 1
      },
      {
        "description": "Fold each sheet into ordered sections, registering headlines and cutting each fold slightly past centre.",
        "position": 2
      },
      {
        "description": "Collate the leaves and plates against the pagination and printed lists to confirm nothing is missing or out of order.",
        "position": 3
      },
      {
        "description": "Guard plates, single leaves, and weak sections by pasting reinforcing strips along their backs.",
        "position": 4
      },
      {
        "description": "For a volume being rebound, pull it to pieces: cut the sewing and bands, remove the old back, soften glue while damp, and detach plates.",
        "position": 5
      },
      {
        "description": "Refold carelessly folded leaves to register and square them, then knock out the old joints flat against a covered iron.",
        "position": 6
      }
    ],
    "taxonomy": "preparation-technique"
  },
