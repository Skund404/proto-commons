  "name": "covering a book in leather",
  "opgl_version": "0.6",
  "persistent": false,
  "properties": {
    "difficulty": "advanced",
    "license": "CC-BY-4.0",
    "names": {
      "en": [
        "covering a book in leather"
      ]
    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (1901), Chapter XII, p.152. Internet Archive.",
        "url": "https://archive.org/details/bookbindingcareo00cockrich/page/152"
      },
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Line up the back with stout paper, and linen or thin leather on heavy books, then trim and smooth it once dry.",
        "position": 1
      },
      {
        "description": "Set the squares, nick off the back corners of the boards, paste the slips, and nip the book lightly in the press to flatten them.",
        "position": 2
      },
      {
        "description": "Cut a cover from the firm part of the skin with a turn-in allowance, then pare it to graded thickness, thin at joints, edges, and caps.",
        "position": 3
      },
      {
        "description": "Square and nip the bands, paste the back and the cover, and let both soak briefly.",
        "position": 4
      },
      {
        "description": "Lay the book on the leather to the turn-in marks, draw the skin over the back, nip the bands, and work the surplus into the panels.",
        "position": 5
      },
      {
        "description": "Turn in the leather at the fore-edges, then the head and tail, rubbing each edge square with a folder.",
        "position": 6
      },
      {
        "description": "Shape the head-caps, tie up larger books to hold the leather, and set the binding aside to dry under light weight with waterproof sheets inside.",
        "position": 7
      },
      {
        "description": "Open the boards to true the joints, mitre the four corners, paste in the filling-in papers, and leave the boards open to draw flat.",
        "position": 8
      }
    ],
    "taxonomy": "covering-technique"
  },
