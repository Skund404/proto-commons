    "names": {
      "en": [
        "flexible sewing on cords"
      ]
    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Mark up the back of the gathered sections for the band and kettle-stitch positions.",
        "position": 1
      },
      {
        "description": "Set the cords up on the sewing frame and tension them from below with the keys.",
        "position": 2
      },
      {
        "description": "Collate the sections and plates and check the order before sewing.",
        "position": 3
      },
      {
        "description": "Sew each section in turn, passing the thread around every cord.",
        "position": 4
      },
      {
        "description": "Lock the head and tail of each section with the kettle stitch.",
        "position": 5
      }
    ],
