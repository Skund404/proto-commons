    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (1902), Chapter XIII, p.173. Internet Archive.",
        "url": "https://archive.org/details/bookbindingcareo00cockrich/page/173"
      },
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, New York, 1902; first published 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Make all sections sound, guard plates and maps, and make end papers with zigzags.",
        "position": 1
      },
      {
        "description": "Press the sections, then mark up and sew several volumes together on shared tapes.",
        "position": 2
      },
      {
        "description": "Build split boards from strawboard faced with thin millboard and square them to the book.",
        "position": 3
      },
      {
        "description": "Glue up the back, round and back the volume, and trim the edges.",
        "position": 4
      },
      {
        "description": "Glue the tape ends to the waste leaves and lay the slips into the opened split boards, then press.",
        "position": 5
      },
      {
        "description": "Set the boards back from the spine to form a French joint and cover in thick leather with protected corners and paper sides.",
        "position": 6
      }
    ],
    "taxonomy": "forwarding-technique"
  },
