{
  "content_hash": "sha256:a4498fa1046f0597bde7dbf0a5af7950bd9c5a1b4803b0626c0b9db36854ff30",
  "created": "2026-06-24",
  "description": "The sequence that prepares a sewn textblock for its boards: the cord slips are frayed out, the book is glued up in the press, then the spine is rounded and backed to set its curve and joint shoulder. Rounding and backing are done after the glue stops being tacky but before it sets hard.",
  "emitter": "opg://commons-seed",
  "id": "rounding-and-backing-seed",
  "kind": "workflow",
  "lineage": {
    "outcome": "unknown",
    "provenance_state": "unasserted"
  },
  "modified": "2026-06-24",
  "name": "rounding and backing",
  "opgl_version": "0.6",
  "persistent": false,
  "properties": {
    "difficulty": "advanced",
    "license": "CC-BY-4.0",
    "names": {
      "en": [
        "rounding and backing",
        "forwarding the back"
      ]
    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (1902), Chapter VIII, p.119. Internet Archive.",
        "url": "https://archive.org/details/bookbindingcareo00cockrich/page/119"
      },
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, New York, 1902; first published 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Inspect the sewn book to confirm every sheet and plate is caught by the thread and the end-paper sewing lies even.",
        "position": 1
      },
      {
        "description": "Cut the cord ends to about two inches each side and fray the strands out into loose fibres; cut tape or vellum bands to the same length.",
        "position": 2
      },
      {
        "description": "Protect the slips with waste board, knock the book square at back and head, and screw it into the lying press with the spine projecting.",
        "position": 3
      },
      {
        "description": "If the back is too swollen, pull the slips tight or use a knocking-down iron and hammer to close the sections, then straighten the slips.",
        "position": 4
      },
      {
        "description": "Apply hot, thin glue and work it between every section with the brush, rubbing the back so it penetrates the full length of each fold.",
        "position": 5
      },
      {
        "description": "Once the glue is no longer tacky, draw the spine over the press edge and tap it round on both sides to an even convex curve.",
        "position": 6
      },
      {
        "description": "Clamp the rounded book between backing boards set below the spine edge and screw the press up very tight, checking the curve is even.",
        "position": 7
      },
      {
        "description": "Fan the section folds outward from the centre with glancing riveting blows to form the joint groove on both sides.",
        "position": 8
      }
    ],
    "taxonomy": "forwarding-technique"
  },
