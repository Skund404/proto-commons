  "created": "2026-06-24",
  "description": "The full sequence for gilding the edges of a book in sheets, from trimming the leaves through scraping, grounding, glairing, laying gold, and burnishing each of the three edges.",
  "emitter": "opg://commons-seed",
  "id": "edge-gilding-before-sewing-seed",
  "kind": "workflow",
  "lineage": {
    "outcome": "unknown",
    "provenance_state": "unasserted"
  },
  "modified": "2026-06-24",
  "name": "edge gilding before sewing",
  "opgl_version": "0.6",
  "persistent": false,
  "properties": {
    "difficulty": "advanced",
    "license": "CC-BY-4.0",
    "names": {
      "en": [
        "edge gilding before sewing"
      ]
    },
    "source_ref": [
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (1901), Chapter VI, p.97. Internet Archive.",
        "url": "https://archive.org/details/bookbindingcareo00cockrich/page/97"
      },
      {
        "label": "Douglas Cockerell, Bookbinding and the Care of Books (D. Appleton, 1901), Internet Archive",
        "url": "https://archive.org/details/bookbindingcareo00cockrich"
      }
    ],
    "steps": [
      {
        "description": "Trim the gathered sections to size, squaring the head against a try square and paring the fore and tail to a guide board.",
        "position": 1
      },
      {
        "description": "Open any folds left uncut with a folder so the edge is continuous before gold is laid.",
        "position": 2
      },
      {
        "description": "Knock the book up to the fore-edge, place it between gilding boards in the lying press, and screw it tight.",
        "position": 3
      },
      {
        "description": "Scrape and rub the edge smooth with fine sand-paper to remove finger-marks and loose paper; wash absorbent paper with vellum size and let it dry.",
        "position": 4
      },
      {
        "description": "Brush on a thick paste of red chalk or blacklead ground with water, then dry-brush to polish the surface.",
        "position": 5
      },
      {
        "description": "Cut the gold to width on the cushion and ready it on a tip or net.",
        "position": 6
      },
      {
        "description": "Float glaire onto the edge, lay the gold evenly over it, and leave it to dry for roughly an hour.",
        "position": 7
      },
      {
        "description": "Rub the edge with leather charged with beeswax, then burnish through thin waxed paper before working the burnisher directly on the gold.",
        "position": 8
      },
      {
        "description": "Repeat the operation at the head and tail, scraping the head more thoroughly for a solid finish.",
        "position": 9
      }
    ],
    "taxonomy": "edge-decoration-technique"
  },
