      "fr": ["point sellier"]
    },
    "steps": [
      { "position": 1, "description": "Mark stitch spacing with a wing divider or pricking iron." },
      { "position": 2, "description": "Punch holes through the leather with a stitching chisel and mallet." },
      { "position": 3, "description": "Thread one needle on each end of the waxed thread." },
      { "position": 4, "description": "Pass both needles through the first hole in opposite directions, pulling tight." },
      { "position": 5, "description": "Repeat for each hole, maintaining consistent tension." },
      { "position": 6, "description": "Backstitch the final two holes and trim flush." }
    ]
  },
